
// Online IDE - Code Editor, Compiler, Interpreter




public class Main {
    public static void main(String[] args) {

        int a = 5;
        int b = 3;

        System.out.println("Expression 1: " + (a + b > 6 && b < 5));

        int count = 4;

        
        System.out.println("Expression 2: " + (count++ + 1));

    
        System.out.println("Expression 3: " + (++count > 5 || count * 2 == 12));

        int x = 6;


        System.out.println("Expression 4: " + (x-- < 5 && x + 1 == 6));

       
    }
}
