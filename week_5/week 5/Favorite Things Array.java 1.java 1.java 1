public class Main {
    public static void main(String[] args) {
        String[] favorites = {
            "Music", "Games", "Food", "Movies", "Travel"
        };

        for (int i = 0; i < favorites.length; i++) {
            System.out.println((i + 1) + ". " + favorites[i]);
        }

        System.out.println("Total length: " + favorites.length);
    }
}
