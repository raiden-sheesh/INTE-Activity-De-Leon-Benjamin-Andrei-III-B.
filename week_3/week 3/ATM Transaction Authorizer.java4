
// Online IDE - Code Edito


import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner input = new Scanner(System.in);

        System.out.print("Enter username: ");
        String username = input.nextLine();

        System.out.print("Enter 4-digit PIN: ");
        String pin = input.nextLine();

        if (username.equals("raiden")) {
            if (pin.equals("1234") && pin.matches("\\d{4}")) {

                System.out.print("Enter account balance: ");
                double balance = input.nextDouble();

                System.out.print("Enter withdrawal amount: ");
                double amount = input.nextDouble();

                String tier;
                double dailyLimit;

                if (balance < 1000) {
                    tier = "Bronze";
                    dailyLimit = 200;
                } else if (balance < 5000) {
                    tier = "Silver";
                    dailyLimit = 1000;
                } else if (balance < 10000) {
                    tier = "Gold";
                    dailyLimit = 3000;
                } else {
                    tier = "Platinum";
                    dailyLimit = 5000;
                }

                double feeRate;

                switch (tier) {
                    case "Bronze":
                        feeRate = 0.02;
                        break;
                    case "Silver":
                        feeRate = 0.015;
                        break;
                    case "Gold":
                        feeRate = 0.01;
                        break;
                    default:
                        feeRate = 0.005;
                }

                double fee = amount * feeRate;

                System.out.println("Account Tier: " + tier);
                System.out.printf("Transaction Fee: %.2f%n", fee);

                if (amount <= 0) {
                    System.out.println("DENIED: Invalid withdrawal amount.");
                } else {
                    if (amount + fee <= balance) {
                        if (amount <= dailyLimit) {
                            System.out.println("APPROVED");
                            System.out.printf(
                                "Remaining Balance: %.2f%n",
                                balance - amount - fee
                            );
                        } else {
                            System.out.println(
                                "DENIED: Withdrawal exceeds your tier's daily limit."
                            );
                        }
                    } else {
                        System.out.println(
                            "DENIED: Insufficient balance to cover withdrawal and fee."
                        );
                    }
                }

            } else {
                System.out.println("DENIED: Incorrect 4-digit PIN.");
            }
        } else {
            System.out.println("DENIED: Incorrect username.");
        }

        input.close();
    }
}
