
// Online IDE - Code Editor, Compiler, Interpreter

import java.util.Scanner;

public class Main {

    static Scanner input = new Scanner(System.in);

   
    static int[][] warehouse = {
        {10, 5, 8},
        {3, -1, 12},
        {2, 7, 6}
    };

    public static void main(String[] args) {
        int choice;

        
        do {
            System.out.println("\n=== INVENTORY SYSTEM ===");
            System.out.println("1. Display Warehouse");
            System.out.println("2. Total Inventory");
            System.out.println("3. Find Critically Low Shelf");
            System.out.println("4. Restock Shelf");
            System.out.println("5. Exit");
            System.out.print("Enter choice: ");
            choice = input.nextInt();

            switch (choice) {
                case 1:
                    displayWarehouse();
                    break;
                case 2:
                    totalInventory();
                    break;
                case 3:
                    findLowShelf();
                    break;
                case 4:
                    restockShelf();
                    break;
                case 5:
                    System.out.println("Exiting inventory system.");
                    break;
                default:
                    System.out.println("Invalid choice.");
            }

        } while (choice != 5);

        input.close();
    }

    static void displayWarehouse() {
        System.out.println("\nWarehouse Shelf Counts:");

        for (int row = 0; row < warehouse.length; row++) {
            for (int col = 0; col < warehouse[row].length; col++) {
                if (warehouse[row][col] == -1) {
                    System.out.print("DAMAGED ");
                } else {
                    System.out.print(warehouse[row][col] + " ");
                }
            }
            System.out.println();
        }
    }

    static void totalInventory() {
        int total = 0;

      
        for (int row = 0; row < warehouse.length; row++) {
            for (int col = 0; col < warehouse[row].length; col++) {
                if (warehouse[row][col] == -1) {
                    continue;
                }
                total += warehouse[row][col];
            }
        }

        System.out.println("Total inventory: " + total);
    }

    static void findLowShelf() {
        boolean found = false;

       
        for (int row = 0; row < warehouse.length; row++) {
            for (int col = 0; col < warehouse[row].length; col++) {
                if (warehouse[row][col] == -1) {
                    continue;
                }

                if (warehouse[row][col] < 5) {
                    System.out.println(
                        "First critically low shelf: Row "
                        + (row + 1) + ", Column " + (col + 1)
                        + " (" + warehouse[row][col] + " items)"
                    );
                    found = true;
                    break;
                }
            }

           
            if (found) {
                break;
            }
        }

        if (!found) {
            System.out.println("No critically low shelves found.");
        }
    }

    static void restockShelf() {
        System.out.print("Enter row (1-3): ");
        int row = input.nextInt();

        System.out.print("Enter column (1-3): ");
        int col = input.nextInt();

       
        while (row < 1 || row > warehouse.length
                || col < 1 || col > warehouse[0].length) {
            System.out.println("Invalid shelf position. Try again.");
            System.out.print("Enter row (1-3): ");
            row = input.nextInt();
            System.out.print("Enter column (1-3): ");
            col = input.nextInt();
        }

        
        if (warehouse[row - 1][col - 1] == -1) {
            System.out.println("Cannot restock a damaged shelf.");
            return;
        }

        int amount;
        System.out.print("Enter quantity to add (greater than 0): ");
        amount = input.nextInt();

        
        while (amount <= 0) {
            System.out.println("Quantity must be greater than 0.");
            System.out.print("Enter quantity to add: ");
            amount = input.nextInt();
        }

        warehouse[row - 1][col - 1] += amount;
        System.out.println("Restocking successful!");
        System.out.println("Updated shelf count: "
            + warehouse[row - 1][col - 1]);
    }
}
